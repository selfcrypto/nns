# packages/settlement — reconciler and verdict watcher
#
# There is deliberately no database URL and no key in this file. The reconciler
# computes owed and settled from the API's /log alone; that independence is the
# deliverable, and it is enforced by there being nothing here to connect to.
# The watcher needs neither either — it reads the same /log and prints what is
# owed, broadcasting nothing.
#
# The M issuer is not built yet. When it is, it gets its own container, its own
# database and the system's only hot key, and none of those belong in this
# process.

# The API being audited. Any operator's; it does not have to be your own.
NNS_API_URL=http://127.0.0.1:8080

# §3 values that are still OPEN. These MUST match the indexer that produced the
# log — a replay under different values derives different verdicts and reports
# them as the operator's divergence.
NNS_NETWORK_ID=5
NNS_LAUNCH_HEIGHT=58177000
NNS_TREASURY_ADDRESS=
NNS_PROTOCOL_ADDRESS=
NNS_ADMIN_ADDRESS=
NNS_MARKETPLACE_ADDRESS=
NNS_LISTING_FEE=0

# Comma-separated, exact, never normalised (§4.1). Must equal the indexer's.
NNS_RESERVED_NAMES=

# Watcher only. Seconds between polls; default 180. /log changes only at a
# checkpoint boundary (CHECKPOINT_INTERVAL, 720 blocks ≈ 12 min), so polling
# faster buys requests rather than news.
NNS_SETTLEMENT_POLL_SECONDS=180
