# packages/settlement — reconciler, verdict watcher, ledger
#
# There is deliberately no key in this file. `reconcile` computes owed and
# settled from the API's /log alone; that independence is the deliverable, and
# it is enforced by there being nothing here to connect to. `watch` needs no
# more — it reads the same /log and prints what is owed, broadcasting nothing.
#
# `ledger` is the one command that opens a database, and it opens **its own**:
# NNS_SETTLEMENT_DATABASE_URL below, never the indexer's NNS_DATABASE_URL.
# `reconcile` and `watch` keep starting on a box where that variable is unset,
# which is how "nothing this service writes is an input to reconcile" stays a
# property of the import graph rather than a promise.
#
# `issue` is the one command that can spend, and it holds the system's only hot
# key. THE KEYS DO NOT BELONG IN THIS FILE, or in any file in this repository:
# they are read from the environment by `keys.ts`, which is the only module
# that reads them and which only `issue-main.ts` imports. They are listed at
# the bottom as names, with no values, for exactly that reason.

# The API being audited. Any operator's; it does not have to be your own.
NNS_API_URL=http://127.0.0.1:8080

# §3 values that are still OPEN. These MUST match the indexer that produced the
# log — a replay under different values derives different verdicts and reports
# them as the operator's divergence.
NNS_NETWORK_ID=5
NNS_LAUNCH_HEIGHT=58177000
NNS_TREASURY_ADDRESS=
NNS_PROTOCOL_ADDRESS=
NNS_ADMIN_ADDRESS=
NNS_MARKETPLACE_ADDRESS=

# Watcher and ledger. Seconds between polls; default 180. /log changes only at a
# checkpoint boundary (CHECKPOINT_INTERVAL, 720 blocks ≈ 12 min), so polling
# faster buys requests rather than news.
NNS_SETTLEMENT_POLL_SECONDS=180

# `ledger` only. Its own database, in its own container — port 5434 in the
# repo's docker-compose.yml, beside but never inside the indexer's. The
# indexer's database is a projection of the chain and can be dropped and
# rebuilt by anyone; this one records payments that have left a hot key and
# cannot be rebuilt from anywhere.
NNS_SETTLEMENT_DATABASE_URL=postgres://nns:nns@127.0.0.1:5434/nns_settlement

# ── `issue` only, below this line ───────────────────────────────────────────

# The node that signs and broadcasts. NNS_RPC_URL wins if set; otherwise the
# host/port pair is assembled, which is the form a client.toml reader knows.
NNS_RPC_URL=http://127.0.0.1:6488
NNS_RPC_USER=
NNS_RPC_PASSWORD=

# Blocks after validityStartHeight at which a pinned M is treated as dead and
# may be replaced. LEAVE THIS UNSET: the node answers it authoritatively through
# getPolicyConstants (transactionValidityWindow, 7200 on mainnet — about two
# hours), read once at startup. Set it only to wait LONGER than the chain
# requires, which costs a stall; a value below the node's window is refused,
# because expiring an attempt while it can still land pins a replacement that
# can also land — the double payment.
# NNS_SETTLEMENT_EXPIRY_BLOCKS=

# §11.5 rule 2: alert when a sender's balance falls below this, in luna. It
# must be well above zero — alerting at zero alerts after the failure — and
# MARKETPLACE_ADDRESS and TREASURY_ADDRESS have no income of their own.
NNS_SETTLEMENT_MIN_BALANCE=

# Fee on every M, in luna. 0 is accepted by the network and is what every other
# NNS sender uses.
NNS_SETTLEMENT_FEE_LUNA=0

# The hot keys: 32 bytes as 64 bare hex characters, one per §6 M sender. Set
# them in the process environment — a secret manager, a systemd credential, the
# container runtime — and NEVER here. A key that derives an address other than
# the matching §3 one is refused at startup, because an M from the wrong sender
# is forfeited rather than rejected (§6 M): the money leaves and the debt stays.
# Both are optional; a deployment that only ever owes from one address should
# hold only that one, and a dry run needs neither.
# NNS_SETTLEMENT_MARKETPLACE_KEY=
# NNS_SETTLEMENT_TREASURY_KEY=
