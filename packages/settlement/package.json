{
  "name": "@nns/settlement",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Settlement service and its independent reconciler. The reconciler is built first and reads /log only — never this service's database.",
  "license": "MIT",
  "files": [
    "dist",
    "migrations",
    "referral-rates.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "reconcile": "node --env-file=.env dist/reconcile-main.js",
    "watch": "node --env-file=.env dist/watch-main.js",
    "ledger": "node --env-file=.env dist/ledger-main.js",
    "issue": "node --env-file=.env dist/issue-main.js"
  },
  "dependencies": {
    "@nimiqnames/core": "workspace:*",
    "@nns/indexer": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
