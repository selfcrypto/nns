{
  "name": "@nimiqnames/anchor",
  "version": "0.1.0",
  "type": "module",
  "description": "NNS anchor contract (\u00a79): a permissionless, append-only event emitter, and the committed record of its compilation.",
  "license": "MIT",
  "author": "Enrique Ferrater",
  "homepage": "https://github.com/selfcrypto/nns#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selfcrypto/nns.git",
    "directory": "packages/anchor"
  },
  "bugs": {
    "url": "https://github.com/selfcrypto/nns/issues"
  },
  "keywords": [
    "nimiq",
    "nns",
    "anchor",
    "evm",
    "merkle",
    "checkpoint",
    "ipfs"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./publisher": {
      "types": "./dist/publish.d.ts",
      "default": "./dist/publish.js"
    },
    "./reader": {
      "types": "./dist/reader.d.ts",
      "default": "./dist/reader.js"
    }
  },
  "files": [
    "contracts",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "compile": "pnpm build && node dist/compile-cli.js",
    "deploy": "pnpm build && node --env-file=.env dist/deploy-cli.js deploy",
    "verify": "pnpm build && node --env-file=.env dist/deploy-cli.js verify",
    "publisher": "pnpm build && node --env-file=.env dist/publish-cli.js publish"
  },
  "dependencies": {
    "@nimiqnames/core": "workspace:*",
    "@noble/hashes": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "solc": "catalog:",
    "typescript": "catalog:",
    "viem": "catalog:",
    "vitest": "catalog:"
  }
}
