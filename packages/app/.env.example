# Deployment configuration — build-time (Vite inlines VITE_* at build).
#
# JSON array of independent NNS APIs. Appended after @nns/resolver's
# DEFAULT_RESOLVERS (empty today). The name is what disagreement reports
# show the user, so it names the operator, not the URL.
VITE_NNS_RESOLVERS=[{"name":"Local dev","url":"http://localhost:8080"}]

# How many resolvers must agree. Launch decision: 1, with the operator named
# (see packages/resolver/README.md, "At launch, the quorum is 1").
VITE_NNS_QUORUM=1

# Operator-run, CORS-open, unauthenticated, read-only RPC endpoint for the
# NC inbox (docs/app-chat.md §4 — getTransactionsByAddress allowlisted, node
# credentials held upstream). Optional: unset shows the Inbox setup state.
VITE_NNS_HISTORY=
