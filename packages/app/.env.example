# Deployment configuration — build-time (Vite inlines VITE_* at build).
#
# JSON array of independent NNS APIs. Appended after @nimiqnames/resolver's
# DEFAULT_RESOLVERS (empty today). The name is what disagreement reports
# show the user, so it names the operator, not the URL.
VITE_NNS_RESOLVERS=[{"name":"Local dev","url":"http://localhost:8080"}]

# How many resolvers must agree. Launch decision: 1, with the operator named
# (see packages/resolver/README.md, "At launch, the quorum is 1").
VITE_NNS_QUORUM=1

# Operator-run, CORS-open, unauthenticated RPC endpoint (docs/app-chat.md §4):
# getTransactionsByAddress + getTransactionByHash for the NC inbox and chat
# confirmation, getBlockNumber for a validity start height, and
# sendRawTransaction to broadcast what the Hub signed. Allowlist exactly
# those upstream; node credentials never reach the browser. Optional: unset
# shows the Inbox setup state and Hub sends cannot broadcast.
VITE_NNS_RPC=

# The NC chat index, if an operator runs one. When set,
# the Inbox reads messages from it instead of pulling each address's whole
# transaction history through VITE_NNS_RPC — the same messages, without the
# ~99% that are not chat and without the 500-transaction window. Optional:
# unset, the Inbox falls back to the RPC endpoint above.
VITE_NNS_CHAT=

# The Nimiq Hub the desktop adapter opens popups against. Default: mainnet.
VITE_NNS_HUB_URL=https://hub.nimiq.com

# Dev-only §8.6 detour for testing a local delegate (src/lib/nns.ts). A chain
# `D` host carries no port and clients hardcode https://, so a delegate on a
# loopback port is unreachable from a browser. With this set under `vite dev`,
# requests to https://localhost/delegated/… are rerouted same-origin, where
# vite.config.ts proxies /delegated to the local delegate port. Record host
# `localhost` in the D. Inert in production builds (import.meta.env.DEV is
# compile-time false) — this can never ship.
#VITE_NNS_DELEGATE_DEV=1
