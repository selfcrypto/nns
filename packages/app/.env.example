# Deployment configuration — build-time (Vite inlines VITE_* at build).
#
# JSON array of independent NNS APIs. Appended after @nns/resolver's
# DEFAULT_RESOLVERS (empty today). The name is what disagreement reports
# show the user, so it names the operator, not the URL.
VITE_NNS_RESOLVERS=[{"name":"Local dev","url":"http://localhost:8080"}]

# How many resolvers must agree. Launch decision: 1, with the operator named
# (see packages/resolver/README.md, "At launch, the quorum is 1").
VITE_NNS_QUORUM=1

# Operator-run, CORS-open, unauthenticated RPC endpoint (docs/app-chat.md §4):
# getTransactionsByAddress + getTransactionByHash for the NC inbox and chat
# confirmation, getBlockNumber for a validity start height, and
# sendRawTransaction to broadcast what the Hub signed. Allowlist exactly
# those upstream; node credentials never reach the browser. Optional: unset
# shows the Inbox setup state and Hub sends cannot broadcast.
VITE_NNS_RPC=

# The Nimiq Hub the desktop adapter opens popups against. Default: mainnet.
VITE_NNS_HUB_URL=https://hub.nimiq.com
