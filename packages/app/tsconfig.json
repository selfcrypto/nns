{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Vite emits; tsc only checks. The base's NodeNext is overridden because
    // this is the one bundled package.
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // Browser code only: no node types, so reaching for Buffer/process/fs is
    // a compile error, same posture as packages/resolver.
    "types": ["vite/client"],
    "noEmit": true,
    // The §10.7 rate table is settlement's JSON, imported for display (lib/referralRates.ts).
    "resolveJsonModule": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["src/**/*.test.ts"]
}
