{
  "name": "@nns/resolver",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Client-side NNS resolution: resolver quorum, §8.3 proof verification, §8.6 delegation. Browser and Node.",
  "license": "MIT",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rendering.css": "./dist/rendering.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/emit-css.mjs",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nns/anchor": "workspace:*",
    "@nns/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
