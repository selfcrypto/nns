{
  "name": "@nimiqnames/resolver",
  "version": "0.1.0",
  "type": "module",
  "description": "Client-side NNS resolution: resolver quorum, \u00a78.3 proof verification, \u00a78.6 delegation. Browser and Node.",
  "license": "MIT",
  "author": "Enrique Ferrater",
  "homepage": "https://github.com/selfcrypto/nns/blob/main/docs/integration.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selfcrypto/nns.git",
    "directory": "packages/resolver"
  },
  "bugs": {
    "url": "https://github.com/selfcrypto/nns/issues"
  },
  "keywords": [
    "nimiq",
    "nns",
    "name-service",
    "resolver",
    "merkle-proof",
    "browser",
    "wallet",
    "exchange"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./rendering.css": "./dist/rendering.css",
    "./nns.js": "./dist/nns.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/emit-css.mjs && vite build",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nimiqnames/anchor": "workspace:*",
    "@nimiqnames/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
