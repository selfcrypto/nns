{
  "name": "@nns/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NNS protocol rules: encoding, validation, reducer, Merkle. Pure and deterministic.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vectors/*.json": "./vectors/*.json"
  },
  "files": [
    "dist",
    "vectors"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gen:reserved": "tsx scripts/gen-reserved-names.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "catalog:",
    "@noble/hashes": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
