{
  "name": "@nns/core",
  "version": "0.1.0",
  "type": "module",
  "description": "NNS protocol rules: encoding, validation, reducer, Merkle. Pure and deterministic.",
  "license": "MIT",
  "author": "Enrique Ferrater",
  "homepage": "https://github.com/selfcrypto/nns#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/selfcrypto/nns.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/selfcrypto/nns/issues"
  },
  "keywords": [
    "nimiq",
    "nns",
    "name-service",
    "naming",
    "blockchain",
    "merkle",
    "deterministic"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vectors/*.json": "./vectors/*.json"
  },
  "files": [
    "dist",
    "vectors"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "gen:reserved": "node scripts/gen-reserved-names.ts",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@noble/curves": "catalog:",
    "@noble/hashes": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
