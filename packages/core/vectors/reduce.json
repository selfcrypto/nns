      "expect": { "resolves": { "kikename": "ALICE" } }
    },
    {
      "id": "X_waits_the_timelock_then_resets_dependent_state",
      "note": "§7.3: owner and target both become the new owner, host and recovery are cleared, offers cancelled, pending X/R void.",
      "steps": [
        {
          "tx": { "blockNumber": 58000000, "txIndex": 0, "sender": "ALICE", "recipient": "TREASURY", "value": "400000000", "text": "NNS1Gkikename" },
          "verdict": { "kind": "OK" }
        },
        {
          "tx": { "blockNumber": 58000000, "txIndex": 1, "sender": "ALICE", "recipient": "PROTOCOL", "value": "1", "text": "NNS1Dkikename|a.com" },
          "verdict": { "kind": "OK" }
        },
        {
          "tx": { "blockNumber": 58000001, "txIndex": 0, "sender": "ALICE", "recipient": "BOB", "value": "1", "text": "NNS1Xkikename" },
          "verdict": { "kind": "OK" }
        },
        { "advanceTo": 58043200, "note": "one block short of maturity" },
        { "check": { "names": { "kikename": { "owner": "ALICE", "host": "a.com" } } } },
        { "advanceTo": 58043201 }
      ],
      "expect": {
        "names": { "kikename": { "owner": "BOB", "target": "BOB", "recovery": null, "host": "" } }
      }
    },
    {
      "id": "K_vetoes_a_pending_transfer",
      "steps": [
        {
          "tx": { "blockNumber": 58000000, "txIndex": 0, "sender": "ALICE", "recipient": "TREASURY", "value": "400000000", "text": "NNS1Gkikename" },
          "verdict": { "kind": "OK" }
        },
        {
          "tx": { "blockNumber": 58000000, "txIndex": 1, "sender": "ALICE", "recipient": "BOB", "value": "1", "text": "NNS1Xkikename" },
          "verdict": { "kind": "OK" }
        },
        {
          "tx": { "blockNumber": 58000001, "txIndex": 0, "sender": "ALICE", "recipient": "PROTOCOL", "value": "1", "text": "NNS1Kkikename" },
          "verdict": { "kind": "OK" }
        },
        { "advanceTo": 58100000 }
      ],
      "expect": { "names": { "kikename": { "owner": "ALICE" } } }
    },
    {
      "id": "K_with_nothing_pending_forfeits",
      "note": "§7.4 lists no such reason. The value at stake is DUST_VALUE; the code records why the message had no effect. See docs/decisions.md.",
      "steps": [
        {
          "tx": { "blockNumber": 58000000, "txIndex": 0, "sender": "ALICE", "recipient": "TREASURY", "value": "400000000", "text": "NNS1Gkikename" },
          "verdict": { "kind": "OK" }
        },
        {
          "tx": { "blockNumber": 58000001, "txIndex": 0, "sender": "ALICE", "recipient": "PROTOCOL", "value": "1", "text": "NNS1Kkikename" },
          "verdict": { "kind": "FORFEIT", "reason": "NOTHING_TO_CANCEL" }
        }
      ],
      "expect": { "names": { "kikename": { "owner": "ALICE" } } }
    },
    {
      "id": "recovery_transfer_uses_the_longer_timelock",
      "steps": [
        {
          "tx": { "blockNumber": 58000000, "txIndex": 0, "sender": "ALICE", "recipient": "TREASURY", "value": "400000000", "text": "NNS1Gkikename" },
          "verdict": { "kind": "OK" }
        },
        {
          "tx": { "blockNumber": 58000000, "txIndex": 1, "sender": "ALICE", "recipient": "CAROL", "value": "1", "text": "NNS1Rkikename" },
          "verdict": { "kind": "OK" }
        },
        { "advanceTo": 58043200 },
        { "check": { "names": { "kikename": { "recovery": "CAROL" } } } },
        {
          "tx": { "blockNumber": 58043200, "txIndex": 0, "sender": "CAROL", "recipient": "CAROL", "value": "1", "text": "NNS1Xkikename" },
          "verdict": { "kind": "OK" }
        },
        { "advanceTo": 58086400, "note": "XFER_TIMELOCK would have matured here" },
        { "check": { "names": { "kikename": { "owner": "ALICE" } } } },
        { "advanceTo": 58302400 }
      ],
      "expect": { "names": { "kikename": { "owner": "CAROL", "recovery": null } } }
    },
    {
      "id": "expiry_then_grace_then_available",
      "steps": [
        {
          "tx": { "blockNumber": 58000000, "txIndex": 0, "sender": "ALICE", "recipient": "TREASURY", "value": "400000000", "text": "NNS1Gkikename" },
          "verdict": { "kind": "OK" }
        },
        { "advanceTo": 215680000 },
        { "check": { "names": { "kikename": { "status": "GRACE" } }, "resolves": { "kikename": null } } },
        { "advanceTo": 223456000 }
      ],
      "expect": { "names": {}, "resolves": { "kikename": null } }
    },
    {
      "id": "renewal_extends_from_the_current_expiry",
      "note": "§6 N: not from the renewal height, so early renewal is never penalised. Sender: anyone.",
      "steps": [
        {
          "tx": { "blockNumber": 58000000, "txIndex": 0, "sender": "ALICE", "recipient": "TREASURY", "value": "400000000", "text": "NNS1Gkikename" },
          "verdict": { "kind": "OK" }
        },
        {
          "tx": { "blockNumber": 58000001, "txIndex": 0, "sender": "BOB", "recipient": "TREASURY", "value": "400000000", "text": "NNS1Nkikename" },
          "verdict": { "kind": "OK" }
        }
      ],
      "expect": { "names": { "kikename": { "owner": "ALICE", "expiry": 373360000 } } }
    },
    {
      "id": "a_winning_B_moves_the_name_and_owes_two_settlements",
      "steps": [
        {
          "tx": { "blockNumber": 58000000, "txIndex": 0, "sender": "ALICE", "recipient": "TREASURY", "value": "400000000", "text": "NNS1Gkikename" },
          "verdict": { "kind": "OK" }
        },
        {
          "tx": { "blockNumber": 58000001, "txIndex": 0, "sender": "ALICE", "recipient": "TREASURY", "value": "1", "text": "NNS1Okikename|100000000" },
          "verdict": { "kind": "OK" }
        },
        {
          "tx": { "blockNumber": 58000002, "txIndex": 0, "sender": "BOB", "recipient": "MARKETPLACE", "value": "100000000", "text": "NNS1Bkikename" },
          "verdict": {
            "kind": "OK",
            "obligations": [
              { "kind": "SALE_PROCEEDS", "owedBy": "MARKETPLACE", "owedTo": "ALICE", "amount": "97500000" },
              { "kind": "COMMISSION", "owedBy": "MARKETPLACE", "owedTo": "TREASURY", "amount": "2500000" }
            ]
          }
        }
      ],
      "expect": {
        "names": { "kikename": { "owner": "BOB", "target": "BOB", "expiry": 215680000 } },
        "note": "The buyer inherits the name's current expiry, and the two legs sum to the price exactly."
      }
    },
    {
      "id": "the_losing_B_is_refunded_not_forfeited",
      "steps": [
        {
          "tx": { "blockNumber": 58000000, "txIndex": 0, "sender": "ALICE", "recipient": "TREASURY", "value": "400000000", "text": "NNS1Gkikename" },
          "verdict": { "kind": "OK" }
        },
        {
          "tx": { "blockNumber": 58000001, "txIndex": 0, "sender": "ALICE", "recipient": "TREASURY", "value": "1", "text": "NNS1Okikename|100000000" },
          "verdict": { "kind": "OK" }
        },
        {
          "tx": { "blockNumber": 58000002, "txIndex": 0, "sender": "BOB", "recipient": "MARKETPLACE", "value": "100000000", "text": "NNS1Bkikename" },
          "verdict": { "kind": "OK" }
        },
        {
          "tx": { "blockNumber": 58000002, "txIndex": 1, "sender": "CAROL", "recipient": "MARKETPLACE", "value": "100000000", "text": "NNS1Bkikename" },
          "verdict": {
            "kind": "REFUND",
            "reason": "OFFER_NOT_OPEN",
            "obligations": [{ "kind": "REFUND", "owedBy": "MARKETPLACE", "owedTo": "CAROL", "amount": "100000000" }]
          }
        }
      ],
      "expect": { "names": { "kikename": { "owner": "BOB" } } }
    },
    {
      "id": "a_refund_is_never_reduced_by_commission",
      "steps": [
        {
          "tx": { "blockNumber": 58000000, "txIndex": 0, "sender": "ALICE", "recipient": "TREASURY", "value": "400000000", "text": "NNS1Gkikename" },
          "verdict": { "kind": "OK" }
        },
        {
          "tx": { "blockNumber": 58000001, "txIndex": 0, "sender": "ALICE", "recipient": "TREASURY", "value": "1", "text": "NNS1Okikename|100000000" },
          "verdict": { "kind": "OK" }
        },
        {
          "tx": { "blockNumber": 58000002, "txIndex": 0, "sender": "BOB", "recipient": "MARKETPLACE", "value": "100000001", "text": "NNS1Bkikename" },
          "verdict": {
            "kind": "REFUND",
            "reason": "WRONG_PRICE",
            "obligations": [{ "kind": "REFUND", "owedBy": "MARKETPLACE", "owedTo": "BOB", "amount": "100000001" }]
          }
        }
      ],
      "expect": { "names": { "kikename": { "owner": "ALICE" } } }
    },
    {
      "id": "an_O_below_MIN_PRICE_forfeits",
      "note": "§6 O: the price MUST be ≥ MIN_PRICE, which is FEE_LONG at the message's height — 40000000 luna here. The four rejected prices are the ones a token floor would have admitted: 0 (no B can satisfy it, §5.4 rejects value: 0), 1 (the token floor considered and rejected), REFUND_FLOOR - 1 (a losing bidder would be forfeited, not refunded, contradicting §7.4), and 19 (floor(19 × 5%) = 0, erasing the AUCTION_MIN_INCREMENT rule). The floor itself is accepted: the boundary is inclusive.",
      "steps": [
        {
          "tx": { "blockNumber": 58000000, "txIndex": 0, "sender": "ALICE", "recipient": "TREASURY", "value": "400000000", "text": "NNS1Gkikename" },
          "verdict": { "kind": "OK" }
        },
        {
          "tx": { "blockNumber": 58000001, "txIndex": 0, "sender": "ALICE", "recipient": "TREASURY", "value": "1", "text": "NNS1Okikename|0" },
          "verdict": { "kind": "FORFEIT", "reason": "BELOW_MIN_PRICE" }
        },
        {
          "tx": { "blockNumber": 58000001, "txIndex": 1, "sender": "ALICE", "recipient": "TREASURY", "value": "1", "text": "NNS1Okikename|1" },
          "verdict": { "kind": "FORFEIT", "reason": "BELOW_MIN_PRICE" }
        },
        {
          "tx": { "blockNumber": 58000001, "txIndex": 2, "sender": "ALICE", "recipient": "TREASURY", "value": "1", "text": "NNS1Okikename|19" },
          "verdict": { "kind": "FORFEIT", "reason": "BELOW_MIN_PRICE" }
        },
        {
          "tx": { "blockNumber": 58000001, "txIndex": 3, "sender": "ALICE", "recipient": "TREASURY", "value": "1", "text": "NNS1Okikename|9999" },
          "verdict": { "kind": "FORFEIT", "reason": "BELOW_MIN_PRICE" }
        },
        {
          "tx": { "blockNumber": 58000001, "txIndex": 4, "sender": "ALICE", "recipient": "TREASURY", "value": "1", "text": "NNS1Okikename|39999999" },
          "verdict": { "kind": "FORFEIT", "reason": "BELOW_MIN_PRICE" }
        },
        {
          "tx": { "blockNumber": 58000001, "txIndex": 5, "sender": "ALICE", "recipient": "TREASURY", "value": "1", "text": "NNS1Okikename|40000000" },
          "verdict": { "kind": "OK" }
        }
      ],
      "expect": { "names": { "kikename": { "owner": "ALICE" } } }
    },
    {
      "id": "MIN_PRICE_moves_with_a_P_that_changes_FEE_LONG",
      "note": "MIN_PRICE is defined as FEE_LONG, not as a luna amount, so a P that moves FEE_LONG moves the floor with it at its effective height. An implementation reading the launch constant instead of the active params passes every other vector here and diverges from this one.",
      "steps": [
        {
          "tx": { "blockNumber": 58000000, "txIndex": 0, "sender": "ADMIN", "recipient": "PROTOCOL", "value": "1", "text": "NNS1P400000000|80000000|250|58043200" },
          "verdict": { "kind": "OK" }
        },
        {
          "tx": { "blockNumber": 58000001, "txIndex": 0, "sender": "ALICE", "recipient": "TREASURY", "value": "400000000", "text": "NNS1Gkikename" },
          "verdict": { "kind": "OK" }
        },
        {
          "tx": { "blockNumber": 58043199, "txIndex": 0, "sender": "ALICE", "recipient": "TREASURY", "value": "1", "text": "NNS1Okikename|40000000" },
          "verdict": { "kind": "OK" }
        },
        {
          "tx": { "blockNumber": 58043200, "txIndex": 0, "sender": "ALICE", "recipient": "TREASURY", "value": "1", "text": "NNS1Okikename|40000000" },
          "verdict": { "kind": "FORFEIT", "reason": "BELOW_MIN_PRICE" }
        },
        {
          "tx": { "blockNumber": 58043200, "txIndex": 1, "sender": "ALICE", "recipient": "TREASURY", "value": "1", "text": "NNS1Okikename|80000000" },
