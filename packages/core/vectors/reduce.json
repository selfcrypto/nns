{
  "vectors": "nns/reduce",
  "version": 1,
  "spec": "nns-spec-v1 draft r18, §7.3, §7.4 and §7.5",
  "description": "Replay scenarios. Each runs its `steps` in order against a fresh state and then checks `expect`. A step is either a transaction (`tx`) or a bare height advance (`advanceTo`), which is how expiry, timelock maturity and governance activation are driven — none of them is triggered by a message.",
  "addresses": {
    "TREASURY": "NQ82 24C1 X9HD 6GVL 4JAG AVF6 AT3K FA0Q H3UN",
    "PROTOCOL": "NQ07 48LK 0DRX 8M65 6NK1 D1PP CYC4 HE99 K857",
    "ADMIN": "NQ67 6CV4 2J2F AREN 8STJ F608 F3LM KJHS MCDQ",
    "MARKETPLACE": "NQ28 8H5M 4NB0 CVP7 AY43 HA8R H7V6 MNSB PGN9",
    "BURN": "NQ07 0000 0000 0000 0000 0000 0000 0000 0000",
    "ALICE": "NQ57 B9KP 90CE KELB BGNF TKLY C0QG 3LM3 EH2H",
    "BOB": "NQ85 FJ4R D8VG PP5D FR7H YQ5H G99J 7V65 JRKK",
    "CAROL": "NQ19 KSMT HHEJ TYNF J1GK 40NK LHSL C5P7 P24M"
  },
  "config": {
    "networkId": 24,
    "launchHeight": 58000000,
    "treasury": "TREASURY",
    "protocol": "PROTOCOL",
    "admin": "ADMIN",
    "marketplace": "MARKETPLACE"
  },
  "constants": {
    "FEE_STANDARD": "400000000",
    "FEE_LONG": "40000000",
    "MIN_PRICE": "FEE_LONG at the message's height, so 40000000 until a P moves it",
    "REFUND_FLOOR": "10000",
    "TERM_LENGTH": 157680000,
    "GRACE_PERIOD": 7776000,
    "XFER_TIMELOCK": 43200,
    "RECOVERY_TIMELOCK": 259200,
    "GOVERNANCE_DELAY": 43200,
    "OFFER_IRREVOCABLE": 8640,
    "OFFER_MAX_LIFETIME": 1296000
  },
  "scenarios": [
    {
      "id": "failed_G_does_not_register_name",
      "note": "The named conformance case from §14. Albatross includes failed transactions in blocks; without §7.5's first rule a failed G takes a name, and two implementations disagreeing produce different roots.",
      "steps": [
        {
          "tx": {
            "blockNumber": 58000000,
            "txIndex": 0,
            "sender": "ALICE",
            "recipient": "TREASURY",
            "value": "400000000",
            "text": "NNS1Gkikename",
            "executionResult": false
          },
          "verdict": { "kind": "IGNORED", "reason": "FAILED_EXECUTION" }
        }
      ],
      "expect": { "names": {}, "resolves": { "kikename": null } }
    },
    {
      "id": "reward_transaction_is_ignored",
      "steps": [
        {
          "tx": {
            "blockNumber": 58000000,
            "txIndex": 0,
            "sender": "ALICE",
            "recipient": "TREASURY",
            "value": "400000000",
            "text": "NNS1Gkikename",
            "isReward": true
          },
          "verdict": { "kind": "IGNORED", "reason": "REWARD_TRANSACTION" }
        }
      ],
      "expect": { "names": {} }
    },
    {
      "id": "wrong_network_is_ignored",
      "steps": [
        {
          "tx": {
            "blockNumber": 58000000,
            "txIndex": 0,
            "sender": "ALICE",
            "recipient": "TREASURY",
            "value": "400000000",
            "text": "NNS1Gkikename",
            "networkId": 25
          },
          "verdict": { "kind": "IGNORED", "reason": "WRONG_NETWORK" }
        }
      ],
      "expect": { "names": {} }
    },
    {
      "id": "non_nns1_traffic_is_ignored",
      "note": "The ordinary case: most chain traffic is not NNS. It earns no log line at all (§7.6).",
      "steps": [
        {
          "tx": {
            "blockNumber": 58000000,
            "txIndex": 0,
            "sender": "ALICE",
            "recipient": "BOB",
            "value": "1",
            "data": "68690a"
          },
          "verdict": { "kind": "IGNORED", "reason": "NOT_NNS1" }
        }
      ],
      "expect": { "names": {} }
    },
    {
      "id": "G_registers_with_target_and_term",
      "steps": [
        {
          "tx": {
            "blockNumber": 58000005,
            "txIndex": 0,
            "sender": "ALICE",
            "recipient": "TREASURY",
            "value": "400000000",
