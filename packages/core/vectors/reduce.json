          "tx": { "blockNumber": 58000000, "txIndex": 0, "sender": "ALICE", "recipient": "TREASURY", "value": "400000000", "text": "NNS1Gkikename" },
          "verdict": { "kind": "OK" }
        },
        {
          "tx": { "blockNumber": 58000001, "txIndex": 0, "sender": "BOB", "recipient": "BOB", "value": "1", "text": "NNS1Skikename" },
