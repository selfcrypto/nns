            "sender": "ALICE",
            "recipient": "TREASURY",
            "value": "40000000",
            "text": "NNS1Gkikename"
          },
          "verdict": { "kind": "FORFEIT", "reason": "INSUFFICIENT_VALUE" }
        }
      ],
      "expect": { "names": {} }
    },
