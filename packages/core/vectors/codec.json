          "ok": false,
          "reason": "UNKNOWN_TYPE"
        }
      },
      {
        "id": "retired_R_is_unknown",
        "note": "`R` carried the recovery address through r19. r20 removed it and did NOT reserve the letter: an `R` built by a pre-r20 client parses as an unknown type and forfeits (§6, §7.4).",
        "text": "NNS1Rkikename",
        "data": "4e4e5331526b696b656e616d65",
        "result": {
          "ok": false,
          "reason": "UNKNOWN_TYPE"
        }
      },
      {
        "id": "over_length",
        "text": "NNS1Gaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "data": "4e4e5331476161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161616161",
        "result": {
          "ok": false,
          "reason": "OVER_LENGTH"
        },
        "note": "65 bytes. The RPC accepts these and returns a hash; the network then silently drops them (§5.1)."
      },
      {
        "id": "odd_length_hex",
        "data": "4e4e5331470",
        "result": {
          "ok": false,
          "reason": "NOT_HEX"
        }
