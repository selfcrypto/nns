        "id": "bare_zero_is_canonical",
        "text": "NNS1Okikename|0",
        "data": "4e4e53314f6b696b656e616d657c30",
        "result": {
          "ok": true,
          "message": {
            "type": "O",
            "name": "kikename",
            "price": "0"
          }
        },
        "note": "Parse is tolerant and the reducer judges: 0 is a canonical decimal, so this parses, and then forfeits BELOW_MIN_PRICE (§6 O). See reduce.json / an_O_below_MIN_PRICE_forfeits."
      }
