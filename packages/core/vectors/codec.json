  "parseOnly": {
    "description": "Read-side cases, including messages no builder will produce. `NOT_NNS1` is the one outcome that earns no log line: §7.5 discards it before a message is parsed.",
    "cases": [
      {
        "id": "not_nns1",
        "text": "hello world",
        "data": "68656c6c6f20776f726c64",
        "result": {
          "ok": false,
          "reason": "NOT_NNS1"
        }
      },
      {
        "id": "empty",
        "data": "",
        "text": "",
        "result": {
          "ok": false,
          "reason": "NOT_NNS1"
        }
      },
      {
        "id": "unknown_type",
        "text": "NNS1Zkikename",
        "data": "4e4e53315a6b696b656e616d65",
