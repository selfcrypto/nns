        "data": "4e4e5331476e316d3171",
        "result": {
          "ok": true,
          "message": {
            "type": "G",
            "name": "n1m1q",
            "ref": null
          }
        },
        "note": "The codec does not judge names. A rejected message still earns a log line (§7.6), so it must parse first."
