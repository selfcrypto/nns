{
  "vectors": "nns/codec",
  "version": 1,
  "spec": "nns-spec-v1 draft r29, §5 and §6",
  "description": "Wire format. `text` is the message as ASCII; `data` is the same bytes as lowercase hex, which is what the RPC carries in both directions (§5.1). Recipients are role names resolved through `addresses`; `value` is luna as a decimal string.",
  "addresses": {
    "TREASURY": "NQ28 TKBF VF67 HP8R Y812 5FNM NNDN TS7Q F5G3",
    "PROTOCOL": "NQ38 NKD4 7ALG YRDQ DXL8 PARE 7JRS JGJD MAU8",
    "ADMIN": "NQ80 6XNV JDFY YEKF HMM3 UCYK VBLP 7H6Y FNXS",
    "MARKETPLACE": "NQ71 TPMV QN9D MV6A 1HX1 NL2Q 4CJG 5J8M QPTB",
    "BURN": "NQ07 0000 0000 0000 0000 0000 0000 0000 0000",
    "ALICE": "NQ57 B9KP 90CE KELB BGNF TKLY C0QG 3LM3 EH2H",
    "BOB": "NQ85 FJ4R D8VG PP5D FR7H YQ5H G99J 7V65 JRKK"
  },
  "config": {
    "networkId": 24
  },
  "roundTrip": {
    "description": "Each case encodes to `data` and parses back to `message`. Every one of the fourteen §6 types appears at least once.",
