{
  // Typecheck everything, including tests, fixtures and the vector tooling.
  // tsconfig.json is the narrower build config: it emits src/ only.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "vectors/**/*.ts", "vitest.config.ts"]
}
