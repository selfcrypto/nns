# The NC chat index (docs/app-chat.md).
#
# Optional infrastructure: the app works without it, reading the chain
# directly. Nothing here touches the registry — separate process, separate
# database, separate schema.

# Its own database. Never the indexer's: this one is disposable, every row is
# rebuildable from the chain, and a rebuild is a re-scan.
NNS_CHAT_DATABASE_URL=postgres://nns:nns@localhost:5433/nns_chat

# A Nimiq node. Credentials stay here and never reach a browser. This file is
# the local-development shape; in a container the node is not on 127.0.0.1 —
# see deploy/chat/.env.example.
NNS_CHAT_RPC_URL=http://127.0.0.1:8648
NNS_CHAT_RPC_USER=
NNS_CHAT_RPC_PASSWORD=

# How far back this index reaches. **Required, with no default**: it is the
# window every reader is told, it must be a height the node still holds, and
# a default would turn the operator's choice into nobody's. Changing it after
# the fact is refused — start a fresh database instead.
NNS_CHAT_START_HEIGHT=

# 24 is main-albatross.
NNS_CHAT_NETWORK_ID=24
NNS_CHAT_POLL_INTERVAL_MS=30000
NNS_CHAT_PORT=8637
NNS_CHAT_MAX_PAGE=500
NNS_CHAT_LOG_LEVEL=info
