{
  "name": "@nns/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tails Nimiq RPC and replays NNS messages through @nns/core. Chain-facing half: RPC client and scan loop.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "start": "node --env-file=.env dist/main.js",
    "dev": "pnpm --filter @nns/indexer... build && node --env-file=.env dist/main.js",
    "migrate": "node --env-file=.env dist/migrate.js"
  },
  "dependencies": {
    "@nns/anchor": "workspace:*",
    "@nns/core": "workspace:*",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
