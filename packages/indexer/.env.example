# packages/indexer — environment
#
# Copy to .env and fill in. .env is gitignored; no secrets in the repo.
#   cp packages/indexer/.env.example packages/indexer/.env
#   pnpm --filter @nns/indexer dev
#
# Only the chain-facing half is wired, so only these are read. Every §3 value
# — LAUNCH_HEIGHT, the four role addresses, RESERVED_NAMES, the O listing fee
# — is a CONSTANT since the launch freeze and has no variable here: one that
# still existed is one an operator could still set.

# ── RPC connection (required) ────────────────────────────────────────────────
# Either set NNS_RPC_URL outright…
NNS_RPC_URL=http://127.0.0.1:6488
# …or leave it blank and set these instead. Our node listens on 6488, not the
# documented default of 8648.
NNS_RPC_HOST=
NNS_RPC_PORT=
NNS_RPC_SCHEME=http

# HTTP basic auth, from the [rpc-server] section of the node's client.toml.
# Leave both blank if the node has no credentials configured.
NNS_RPC_USER=
NNS_RPC_PASSWORD=

# ── Chain (required) ─────────────────────────────────────────────────────────
# §7.5 guards against a node fed by a different network. 24 is main-albatross.
NNS_NETWORK_ID=24

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres. The indexer migrates on startup; `pnpm --filter @nns/indexer migrate`
# runs the migrations alone.
NNS_DATABASE_URL=postgres://nns:nns@127.0.0.1:5432/nns

# ── Where an empty database comes from (optional; default scratch) ───────────
#
#   scratch   Replay every batch from LAUNCH_HEIGHT. The default, and the only
#             mode that derives the whole registry from the chain (§8.4 Tier 3).
#             Roughly ten hours for a year of chain against a colocated node.
#   snapshot  Download another operator's §8.2 log, verify it against the §8.1
#             commitment they publish, replay it, and scan from there. Minutes.
#   hybrid    snapshot, then re-derive the same range from the chain in the
#             background and check every commitment against the stored one.
#             Usable immediately, Tier 3 shortly after. Needs a node that still
#             holds LAUNCH_HEIGHT, and refuses at startup if it does not.
#
# Read only when the database is empty: a database that has scanned a batch is
# never re-seeded, because where its state came from is a fact it already
# holds. `hybrid`'s background pass is the exception — it resumes on every
# start while an unverified range remains, so setting `hybrid` after a
# `snapshot` bootstrap runs the verification.
#
# What a snapshot cannot check is **omission**: a message that was on chain and
# is missing from both the peer's log and its state commits perfectly. The
# resolver discloses the range on /params (`verification.verifiedFrom`) rather
# than claiming a depth it does not have.
#NNS_START_MODE=scratch

# The API root of another operator's resolver — NOT this deployment's own.
# Required for snapshot and hybrid, ignored by scratch.
#NNS_SNAPSHOT_URL=https://resolver.example.com

# ── Anchor-sourced bootstrap (NNS_SNAPSHOT_SOURCE=anchor) ────────────────────
#
# `peer` (default) asks one operator for the log AND for the checkpoint it says
# commits to it. `anchor` takes the commitment off the §9 contract instead:
# ANCHOR_QUORUM listed publishers must agree, seen by at least two independent
# RPC endpoints, and the bytes then come from any IPFS gateway with the gateway
# trusted for nothing. The check is that replaying those bytes reproduces the
# anchored commitment — the §8.2 log hash is one of its six inputs, so a single
# wrong byte moves it.
#
# Note the CID cannot check the bytes: `logDigest` in an Anchored event is the
# CID's sha2-256 multihash, not the keccak log hash ("The CID is a locator, not
# a verifier").
#NNS_SNAPSHOT_SOURCE=peer

# With SOURCE=anchor, NNS_SNAPSHOT_URL is an IPFS gateway root instead of an
# API root. `{cid}` is substituted where it appears (subdomain gateways);
# otherwise `/ipfs/<cid>` is appended.
#NNS_SNAPSHOT_URL=https://ipfs.io
#NNS_SNAPSHOT_URL=https://{cid}.ipfs.dweb.link

# Two or more independent anchor-chain endpoints, comma-separated. §9: the
# provider is the host's, and one endpoint can lie alone — the reader refuses a
# single one rather than treating it as a cross-check.
#NNS_SNAPSHOT_ANCHOR_RPC=https://ethereum-sepolia-rpc.publicnode.com,https://rpc.sepolia.org

#NNS_SNAPSHOT_ANCHOR_CONTRACT=

# ANCHOR_PUBLISHERS, comma-separated. An unlisted publisher is ignored, never
# counted and never a mismatch (§8.5 #1) — so an empty list is not a lenient
# default, it is no check, and the bootstrap refuses.
#NNS_SNAPSHOT_ANCHOR_PUBLISHERS=

# How far back to scan for Anchored events. Defaults to the reader's
# DEFAULT_READER_LOOKBACK_BLOCKS (250,000, ~35 days of 12 s blocks) — which is
# ABOVE the eth_getLogs range cap of common free endpoints. publicnode's
# Sepolia caps at 50,000 and answers a wider range with an error, which the §9
# cross-check correctly reads as "couldn't check" rather than "no anchor", so
# the bootstrap refuses with the cap quoted. @nimiqnames/anchor's own publisher ships
# NNS_ANCHOR_LOOKBACK_BLOCKS=45000 for the same reason. The window only has to
# exceed ANCHOR_STALENESS_LIMIT_SEC (48 h); 45,000 blocks is about a week.
#NNS_SNAPSHOT_ANCHOR_LOOKBACK=45000

# Distinct listed publishers that must agree. Defaults to §3's ANCHOR_QUORUM.
# Lowering it is allowed and logged as `anchor.quorum-below-spec` — a
# deployment whose second publisher is not live yet is a real state, and saying
# so beats pretending the attestation is wider than it is.
#NNS_SNAPSHOT_ANCHOR_QUORUM=2

# ── Tuning (optional; defaults shown) ────────────────────────────────────────
NNS_POLL_INTERVAL_MS=15000
NNS_RPC_TIMEOUT_MS=30000
NNS_RPC_ATTEMPTS=4
NNS_LOG_LEVEL=info

# Ceiling on how often the `indexer.progress` heartbeat repeats. It also fires
# every 2,000 batches, so a backfill reports on work done and the tail reports
# on wall clock.
NNS_PROGRESS_INTERVAL_MS=60000
