# packages/indexer — environment
#
# Copy to .env and fill in. .env is gitignored; no secrets in the repo.
#   cp packages/indexer/.env.example packages/indexer/.env
#   pnpm --filter @nns/indexer dev
#
# Only the chain-facing half is wired, so only these are read. The deployment
# constants that core's defineConfig needs (TREASURY_ADDRESS, PROTOCOL_ADDRESS,
# ADMIN_ADDRESS, MARKETPLACE_ADDRESS, the O listing fee, RESERVED_NAMES) are
# still OPEN in spec §3 and are deliberately absent — an unused required
# variable is a variable someone fills with a placeholder.

# ── RPC connection (required) ────────────────────────────────────────────────
# Either set NNS_RPC_URL outright…
NNS_RPC_URL=http://127.0.0.1:6488
# …or leave it blank and set these instead. Our node listens on 6488, not the
# documented default of 8648.
NNS_RPC_HOST=
NNS_RPC_PORT=
NNS_RPC_SCHEME=http

# HTTP basic auth, from the [rpc-server] section of the node's client.toml.
# Leave both blank if the node has no credentials configured.
NNS_RPC_USER=
NNS_RPC_PASSWORD=

# ── Chain (required) ─────────────────────────────────────────────────────────
# §7.5 guards against a node fed by a different network. 24 is main-albatross.
NNS_NETWORK_ID=24

# §3, §7.2 — indexers start here, not at genesis. Still OPEN in the spec; must
# be at or after the node's own sync point, since state sync brings no history.
NNS_LAUNCH_HEIGHT=

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres. The indexer migrates on startup; `pnpm --filter @nns/indexer migrate`
# runs the migrations alone.
NNS_DATABASE_URL=postgres://nns:nns@127.0.0.1:5432/nns

# ── The §3 values that are still OPEN ────────────────────────────────────────
# The reducer cannot run without them, so they are required. All four addresses
# must parse and must be distinct (§3, §10.6) — core's defineConfig checks both
# at startup. They are injected rather than baked in precisely so a placeholder
# cannot survive quietly into a mainnet build.
NNS_TREASURY_ADDRESS=
NNS_PROTOCOL_ADDRESS=
NNS_ADMIN_ADDRESS=
NNS_MARKETPLACE_ADDRESS=

# Listing fee for an `O`, in luna (1 NIM = 100,000 luna). Still OPEN in §6 `O`.
NNS_LISTING_FEE=0

# §4.1 rule 6, comma-separated, lowercase and matched exactly. Empty for now —
# the published list is due before mainnet launch, not before code.
NNS_RESERVED_NAMES=

# ── Constants profile (optional) ─────────────────────────────────────────────
# 'mainnet' (the default) or 'fast' — core's test-bench tempo: waiting periods
# ÷1000, fee bands ÷100. Anything but mainnet warns loudly at startup, joins
# the config fingerprint (a fast database refuses to resume under mainnet and
# vice versa), and marks every derived commitment — fast roots are never a
# conformance baseline.
NNS_PROFILE=mainnet

# ── Tuning (optional; defaults shown) ────────────────────────────────────────
NNS_POLL_INTERVAL_MS=15000
NNS_RPC_TIMEOUT_MS=30000
NNS_RPC_ATTEMPTS=4
NNS_LOG_LEVEL=info

# Ceiling on how often the `indexer.progress` heartbeat repeats. It also fires
# every 2,000 batches, so a backfill reports on work done and the tail reports
# on wall clock.
NNS_PROGRESS_INTERVAL_MS=60000
