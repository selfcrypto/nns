# The node's RPC — the relay's only upstream, and the one credential this
# service holds. Any URL it can reach: `host.docker.internal` for a node on the
# Docker host, a LAN or WireGuard address for one elsewhere. **Not
# `127.0.0.1`** from inside a container, where that is the container.
#
# User and password come from the node's client.toml `[rpc-server]`. Both blank
# if it has none — blank means absent, not an empty credential, and half a
# credential is refused at boot.
NNS_RELAY_UPSTREAM_URL=http://host.docker.internal:6488
NNS_RELAY_UPSTREAM_USER=
NNS_RELAY_UPSTREAM_PASSWORD=

# Binds loopback by default: exposure is an explicit opt-in, with a TLS
# terminator or tunnel in front (the app requires HTTPS).
NNS_RELAY_LISTEN_HOST=127.0.0.1
NNS_RELAY_LISTEN_PORT=8641

# The broadcast kill switch: 0 refuses sendRawTransaction with 403 (a
# definite rejection to the app) while reads stay up.
NNS_RELAY_BROADCAST=1

# Trust x-forwarded-for only when something trustworthy actually sets it
# (a reverse proxy or tunnel directly in front). Otherwise the rate-limit
# key is attacker-chosen.
NNS_RELAY_TRUST_FORWARDED_FOR=0

# Optional overrides; defaults are 60 reads/min and 5 broadcasts/min per IP,
# with a global broadcast ceiling of 60/min.
NNS_RELAY_READ_PER_MINUTE=
NNS_RELAY_BROADCAST_PER_MINUTE=
