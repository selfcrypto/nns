# packages/admin — environment
#
# Copy to .env and fill in. .env is gitignored; no secrets in the repo.
#   cp packages/admin/.env.example packages/admin/.env
#   pnpm --filter @nns/admin build
#   pnpm --filter @nns/admin start u <name> <effective-height> [recipient]
#   pnpm --filter @nns/admin start p <fee_standard> <fee_long> <commission_bp> <effective-height>
#
# Both are dry runs: they print what the message would do and send nothing.
# Append --send to broadcast.
#
# Variable names match packages/indexer/.env.example on purpose — on a box
# that runs both, one set of values serves. The admin *private key* is
# deliberately not here: it lives in the node's wallet (importRawKey), and the
# CLI only unlocks it by address (docs/rpc-reference.md §5).

# ── RPC connection (required) ────────────────────────────────────────────────
# Either set NNS_RPC_URL outright…
NNS_RPC_URL=http://127.0.0.1:6488
# …or leave it blank and set these instead. Our node listens on 6488, not the
# documented default of 8648.
NNS_RPC_HOST=
NNS_RPC_PORT=
NNS_RPC_SCHEME=http

# HTTP basic auth, from the [rpc-server] section of the node's client.toml.
# Leave both blank if the node has no credentials configured.
NNS_RPC_USER=
NNS_RPC_PASSWORD=

# ── API base URL (required by `p` only) ──────────────────────────────────────
# Three of §10.6's bounds are relative — each price may move at most
# PRICE_MAX_FACTOR from the one in effect, the commission at most
# COMMISSION_MAX_STEP, and a P at all only PRICE_MIN_INTERVAL after the last
# accepted one. GET /params answers all of it, stamped with the height it read
# at; no node knows any of it. `u` does not need this.
NNS_API_URL=http://127.0.0.1:8080

# ── Network (required) ───────────────────────────────────────────────────────
# The only §3-adjacent value left: every other one — LAUNCH_HEIGHT, the four
# role addresses, RESERVED_NAMES, the listing fee — is a CONSTANT since the
# launch freeze and has no variable here. The admin key stays in the node's
# wallet; the CLI unlocks CONSTANTS.ADMIN_ADDRESS by address.
NNS_NETWORK_ID=24
