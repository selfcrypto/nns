# packages/api — environment
#
# Copy to .env and fill in. .env is gitignored; no secrets in the repo.
#   cp packages/api/.env.example packages/api/.env
#   pnpm --filter @nns/api dev
#
# The API holds no keys and applies no protocol rules, so it needs far less
# than the indexer: a database to read and the two §3 values that shape
# answers. The four OPEN addresses are deliberately absent — an unused
# required variable is a variable someone fills with a placeholder.

# ── Database (required) ──────────────────────────────────────────────────────
# The indexer's Postgres — or a read replica of it; every query runs in a
# READ ONLY transaction and the API never migrates.
NNS_DATABASE_URL=postgres://nns:nns@127.0.0.1:5433/nns

# ── HTTP bind (optional; defaults shown) ─────────────────────────────────────
# Loopback by default. A container sets NNS_API_HOST=0.0.0.0 explicitly.
NNS_API_HOST=127.0.0.1
NNS_API_PORT=8635

# This service reads no §3 value at all. RESERVED_NAMES (for /available) and
# the O listing fee (for /params) are CONSTANTS since the launch freeze, so
# there is nothing here that can drift from the indexer's.

# ── Tuning (optional; defaults shown) ────────────────────────────────────────
NNS_LOG_LEVEL=info
