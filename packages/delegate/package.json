{
  "name": "@nns/delegate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reference §8.6 delegate host: answers subdomain lookups for the names its owner points at it. Not registry infrastructure.",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "start": "node --env-file=.env dist/main.js",
    "dev": "pnpm --filter @nns/delegate... build && node --env-file=.env dist/main.js"
  },
  "dependencies": {
    "@nns/core": "workspace:*"
  },
  "devDependencies": {
    "@nns/resolver": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
