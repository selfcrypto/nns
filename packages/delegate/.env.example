# packages/delegate — environment
#
# Copy to .env and fill in. .env is gitignored; no secrets in the repo.
#   cp packages/delegate/.env.example packages/delegate/.env
#   pnpm --filter @nns/delegate dev
#
# The smallest configuration in the workspace, and the only package with no §3
# material at all: a delegate holds no keys, reads no chain, has no database
# and applies no protocol rules. It serves one file over one socket.

# ── The labels file (required) ───────────────────────────────────────────────
# label → address, reloaded without a restart. See labels.example.json.
NNS_DELEGATE_LABELS=./labels.json

# The name this host answers for. Cross-checked against the file's own `name`
# at boot and used for nothing else — §8.6's URL carries only the label, so no
# request can be checked against it (see README.md).
# NNS_DELEGATE_NAME=binance

# ── HTTP bind (optional; defaults shown) ─────────────────────────────────────
# Loopback by default. A container sets NNS_DELEGATE_HOST=0.0.0.0 explicitly.
# TLS is the proxy's job: §8.6 implies https:// and clients hardcode it.
NNS_DELEGATE_HOST=127.0.0.1
NNS_DELEGATE_PORT=8636

# Serve under a path prefix, so one host can answer for two names — §6 `D`
# permits a short path (`nns.example.com/binance`), and without one the two
# names share a single label namespace.
# NNS_DELEGATE_BASE_PATH=/binance

# ── Tuning (optional; defaults shown) ────────────────────────────────────────
# ttl for labels that state none. Clients cap caching at one hour regardless
# (§8.6 step 4).
NNS_DELEGATE_DEFAULT_TTL=300

# How often the labels file's mtime and size are checked. SIGHUP forces a
# reload; a reload that fails leaves the previous file serving.
NNS_DELEGATE_RELOAD_SEC=5

NNS_LOG_LEVEL=info
