# `/.env` — the repository root file, and the **only** thing that reads it is
# `docker-compose.yml`, for the `${...}` substitutions in it.
#
#   cp .env.example .env && docker compose up
#
# It is gitignored, and it is not application configuration: no service loads
# it, and nothing outside compose looks for it. Running a service directly
# instead (`pnpm --filter @nns/indexer dev`) reads that package's own `.env` —
# `packages/indexer/.env`, `packages/api/.env`, … — which have the same
# variable names and their own commented examples. The two kinds are separate
# on purpose: the database host differs (`postgres` inside the compose network,
# `127.0.0.1` outside), and mixing them produces a service that connects to the
# wrong database and reports success.
#
# **This is the development stack.** A deployment uses `deploy/<role>/`, which
# carries its own `.env.example` with only that role's variables.
#
# Everything with a working default is defaulted in the compose file itself.
# Every §3 value — LAUNCH_HEIGHT, the four role addresses, RESERVED_NAMES, the
# O listing fee — is a CONSTANT since the launch freeze and has no variable
# anywhere: one that still existed is one an operator could still set, which is
# the silent-divergence surface the freeze closed.

# ── The node (the one thing most deployments change) ─────────────────────────
# Default: a node on the Docker host's port 6488, which is where ours listens.
# Any reachable URL works; `127.0.0.1` will not, since that is the container.
NNS_RPC_URL=http://host.docker.internal:6488

# From the [rpc-server] section of the node's client.toml. Both blank if it has
# none — blank means absent, and half a credential is refused at boot.
NNS_RPC_USER=
NNS_RPC_PASSWORD=

# 24 is main-albatross. §7.5 rejects transactions from any other network.
NNS_NETWORK_ID=24

# ── Postgres ─────────────────────────────────────────────────────────────────
# The password is the container's own; the port is where it is published on the
# host's loopback, 5433 to stay clear of a local server.
NNS_POSTGRES_PASSWORD=nns
NNS_POSTGRES_PORT=5433

# The settlement ledger's separate server. Nothing depends on it.
NNS_SETTLEMENT_POSTGRES_PASSWORD=nns
NNS_SETTLEMENT_POSTGRES_PORT=5434

# ── Tuning (optional; defaults shown) ────────────────────────────────────────
# debug prints a line per batch and per candidate — useful against a test node,
# far too much against mainnet.
NNS_LOG_LEVEL=info

# Heartbeat ceiling. `indexer.progress` also fires every 2,000 batches.
NNS_PROGRESS_INTERVAL_MS=60000

# Batch fetches in flight at once. The apply order never changes, so this
# changes how long a backfill takes and no byte of what it produces.
# Measured over the tunnel: 502 batches/min at 1, 7,878 at 16, 12,948 at 32.
NNS_SCAN_PREFETCH=16

NNS_POLL_INTERVAL_MS=15000
NNS_RPC_TIMEOUT_MS=30000
NNS_RPC_ATTEMPTS=4
