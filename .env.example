# Repository root .env — read by docker-compose.yml only.
#
#   cp .env.example .env && docker compose up
#
# This is the *container* configuration. Running the indexer directly instead
# (`pnpm --filter @nns/indexer dev`) reads `packages/indexer/.env`, which has
# the same variable names and its own commented example. The two are separate
# files on purpose: the database host differs (`postgres` inside the compose
# network, `127.0.0.1` outside), and mixing them produces an indexer that
# connects to the wrong database and reports success.

# ── The node (the one thing most deployments change) ─────────────────────────
# Default: a node on the Docker host's port 6488, which is where ours listens.
# Any reachable URL works; `127.0.0.1` will not, since that is the container.
NNS_RPC_URL=http://host.docker.internal:6488

# From the [rpc-server] section of the node's client.toml. Blank if it has none.
NNS_RPC_USER=
NNS_RPC_PASSWORD=

# ── Required: the §3 values still OPEN in the spec ───────────────────────────
# Compose refuses to start without these, by name. They have no defaults
# anywhere — a placeholder address parses, runs, matches nothing, and produces
# an empty registry with a clean log.

# §3, §7.2 — indexers start here, not at genesis. Must be at or after the
# node's own sync point: state sync brings no history.
NNS_LAUNCH_HEIGHT=

# All four must parse and be distinct (§3, §10.6); core's defineConfig checks
# both at startup.
NNS_TREASURY_ADDRESS=
NNS_PROTOCOL_ADDRESS=
NNS_ADMIN_ADDRESS=
NNS_MARKETPLACE_ADDRESS=

# ── Optional (defaults shown) ────────────────────────────────────────────────
# 24 is main-albatross. §7.5 rejects transactions from any other network.
NNS_NETWORK_ID=24

# Postgres. The password is the container's own; the port is where it is
# published on the host's loopback, 5433 to stay clear of a local server.
NNS_POSTGRES_PASSWORD=nns
NNS_POSTGRES_PORT=5433

# debug prints a line per batch and per candidate — useful against a test node,
# far too much against mainnet.
NNS_LOG_LEVEL=info

# Heartbeat ceiling. `indexer.progress` also fires every 2,000 batches.
NNS_PROGRESS_INTERVAL_MS=60000

NNS_POLL_INTERVAL_MS=15000
NNS_RPC_TIMEOUT_MS=30000
NNS_RPC_ATTEMPTS=4
