# The notification service (tasks/26). Optional: the app works without it.
#
#   cp .env.example .env && chmod 600 .env && docker compose up -d --build

# The resolver API this service reads the log and the registry from. Any NNS
# API works, and the public URL is the right one even for the box's own: the
# other roles publish on the host's loopback, which a container cannot reach
# (`host.docker.internal` is the bridge, not 127.0.0.1), and the edge in
# front of them is what makes the API public in the first place.
NNS_NOTIFY_API_URL=https://api.example.com

# The chat index (deploy/chat), for "new message" notifications, through the
# same edge. Unset means no chat notifications; everything else still runs.
NNS_NOTIFY_CHAT_URL=https://example.com/chat

# Where a browser reaches this service: the base of every link it mails and
# of the app's calls. Under deploy/edge it is the app's origin plus /notify.
NNS_NOTIFY_PUBLIC_URL=https://example.com/notify
# The app, for the links a message carries. Default: the origin of the URL above.
NNS_NOTIFY_APP_URL=
# The host named in the text the wallet signs. Default: the app's host.
NNS_NOTIFY_HOST=

# The Telegram bot, from BotFather. Unset means no Telegram. The bot's
# username is read from the token at start (getMe), so it is not repeated
# here. Long polling: no webhook, no inbound route.
NNS_NOTIFY_TELEGRAM_TOKEN=

# SMTP submission. Unset host means no email. 587 is STARTTLS, 465 is
# implicit TLS; the client refuses to authenticate in the clear. The From
# address should be on a domain whose DKIM and DMARC the server signs for.
# With the `mail` profile below: host `mailer`, secure `plain`, no user.
NNS_NOTIFY_SMTP_HOST=
NNS_NOTIFY_SMTP_PORT=587
NNS_NOTIFY_SMTP_SECURE=
NNS_NOTIFY_SMTP_USER=
NNS_NOTIFY_SMTP_PASSWORD=
NNS_NOTIFY_SMTP_FROM=Nimiq Names <notify@example.com>

# The outbound-only relay (`docker compose --profile mail up -d`): the
# sending domain and the hostname the relay announces, which must be the
# IP's reverse name, with an A record pointing back. README.md has the DNS.
NNS_NOTIFY_MAIL_DOMAIN=example.com
NNS_NOTIFY_MAIL_HOSTNAME=mail.example.com
NNS_NOTIFY_MAIL_DKIM_SELECTOR=notify

# Which signature conventions a sign-in accepts, in order: `nimiq` (the Hub,
# the Keyguard and, measured 2026-09-23, Nimiq Pay: prefix + length + text,
# SHA-256) and `raw` (the bytes as they are). Unset means `nimiq` alone.
NNS_NOTIFY_SIGN_CONVENTIONS=

# 24 is main-albatross.
NNS_NOTIFY_NETWORK_ID=24

# Where the HTTP endpoint publishes. Loopback by default: put the TLS
# terminator in front (README.md), never expose 8638 directly.
NNS_NOTIFY_PUBLISH=127.0.0.1:8638

NNS_NOTIFY_POSTGRES_PASSWORD=nns
NNS_NOTIFY_POLL_SECONDS=60
NNS_NOTIFY_SESSION_TTL_DAYS=30
NNS_NOTIFY_MAX_FAILURES=5
NNS_NOTIFY_LOG_LEVEL=info
