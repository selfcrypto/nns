# The public status page — Uptime Kuma behind the edge, public paths only.
#
# Mounted by status.yml; absent unless the operator opts in. Kuma's dashboard
# and login stay reachable only on 127.0.0.1:3001 over an SSH tunnel: the six
# locations below are exactly what an anonymous status-page view fetches, and
# everything else is redirected to the page rather than proxied. Widening this
# list is how the admin UI ends up public — mirror the monitor's own docs
# before touching it.
#
# The public paths poll over plain HTTP; only the logged-in dashboard uses a
# websocket, and it is deliberately not served here — so no upgrade headers,
# and adding them would not be a fix but a widening.

server {
    listen 443 ssl;
    http2 on;
    server_name ${NNS_EDGE_STATUS_HOST};

    acme_certificate letsencrypt;
    ssl_certificate     $acme_certificate;
    ssl_certificate_key $acme_certificate_key;

    location /status/ { proxy_pass http://127.0.0.1:3001; proxy_set_header Host $host; }
    location /assets/ { proxy_pass http://127.0.0.1:3001; proxy_set_header Host $host; }
    location /api/status-page/ { proxy_pass http://127.0.0.1:3001; proxy_set_header Host $host; }
    location = /icon.svg { proxy_pass http://127.0.0.1:3001; proxy_set_header Host $host; }
    location /upload/ { proxy_pass http://127.0.0.1:3001; proxy_set_header Host $host; }
    location = /manifest.json { proxy_pass http://127.0.0.1:3001; proxy_set_header Host $host; }

    location / {
        return 302 /status/${NNS_EDGE_STATUS_SLUG};
    }
}
