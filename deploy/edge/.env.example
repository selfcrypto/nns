# deploy/edge — the whole configuration is your hostnames.
#
#   cp .env.example .env
#
# Each must already resolve to this machine, and port 80 must be reachable
# from the internet: that is how the http-01 challenge is answered. Nothing
# else is needed — issuance and renewal are nginx's job from then on.

# The mini app. Its own nginx serves the bundle and routes /api/ and /rpc.
NNS_EDGE_APP_HOST=example.com

# The resolver API standalone — the URL other people embed.
NNS_EDGE_RESOLVER_HOST=resolver.example.com

# The §8.6 delegate. §8.6 hardcodes https://, so this one is not optional:
# a delegate without publicly trusted TLS is unreachable by every client.
NNS_EDGE_DELEGATE_HOST=delegated.example.com

# ── Rarely changed ───────────────────────────────────────────────────────────
# The host's DNS stub. 127.0.0.53 is systemd-resolved; use 127.0.0.11 only
# inside a Docker network, which this is not.
#NNS_EDGE_RESOLVER_ADDR=127.0.0.53

# Let's Encrypt **staging**, for rehearsing issuance without spending the
# production rate limit. The certificates it returns are not browser-trusted.
#NNS_EDGE_ACME_URI=https://acme-staging-v02.api.letsencrypt.org/directory
