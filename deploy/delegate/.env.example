# deploy/delegate — the whole configuration of a delegate host.
#
#   cp .env.example .env
#
# Nothing here is required. A delegate with an empty `.env` and a labels file
# beside it serves correctly on 127.0.0.1:8636; every line below is either a
# convenience or a second name on the same host.
#
# There is no node, no database, no credential and no §3 value — a delegate
# reads a JSON file and answers HTTP.

# ── The labels directory ─────────────────────────────────────────────────────
# Host directory holding `labels.json`, mounted read-only at /labels. The
# directory rather than the file, because a single-file bind mount pins the
# inode and an editor's atomic save would leave the container serving stale
# bytes with a green healthcheck. Edits — in place or by rename — are picked
# up without a restart; a file that fails to parse leaves the previous one
# serving.
#NNS_DELEGATE_LABELS_DIR=./labels

# ── Where it listens ─────────────────────────────────────────────────────────
# Host bind for the published port. Loopback because the thing that should be
# reachable from outside is your TLS terminator, not this. Set
# `0.0.0.0:8636` only when something else fronts it (a proxy on another host,
# a container network you control).
#NNS_DELEGATE_PUBLISH=127.0.0.1:8636

# ── One host, several names ──────────────────────────────────────────────────
# Nothing is needed for this, and there is no setting for it. The labels file
# holds every name, the request carries the parent, and one container answers
# for all of them — on a bare host and under any path a `D` names, because a
# path says where the delegate listens and the server ignores it.

# Comma-separated names each cross-checked for presence in the labels file at
# boot, and used for nothing else — a miss is a misdeployed file, which is
# worth catching before it answers with another owner's addresses.
#NNS_DELEGATE_NAME=alice,bob

# ── Tuning (defaults shown) ──────────────────────────────────────────────────
# Used for labels whose entry states no ttl. Clients cap caching at one hour
# regardless (§8.6 step 4).
#NNS_DELEGATE_DEFAULT_TTL=300

# How often the labels file's mtime and size are checked. SIGHUP forces it.
#NNS_DELEGATE_RELOAD_SEC=5

#NNS_LOG_LEVEL=info
