# The NC chat index. Optional infrastructure: the app works without it.
#
#   cp .env.example .env && docker compose up -d --build

# A Nimiq node this container can reach — `host.docker.internal` for one on the
# host, a LAN or WireGuard address for one elsewhere. **Not `127.0.0.1`**: in a
# container that is the container. Credentials stay here; the browser never
# sees them, and this service proxies nothing.
#
# Retention matters less than it does for the indexer: this one only needs the
# node to still hold NNS_CHAT_START_HEIGHT below, and it refuses to start
# rather than indexing a silent gap if it does not.
NNS_CHAT_RPC_URL=http://host.docker.internal:6488
NNS_CHAT_RPC_USER=
NNS_CHAT_RPC_PASSWORD=

# How far back the index reaches. **Required, no default, and fixed once the
# database has been populated** — the service refuses to start if it changes,
# because this number is the window every reader is told: raising it would
# hide messages that are there, lowering it would claim messages never
# scanned. Pick a height at or below your first chat traffic; going further
# back only scans empty batches.
NNS_CHAT_START_HEIGHT=59000000

# 24 is main-albatross.
NNS_CHAT_NETWORK_ID=24

# Where the read endpoint publishes. Loopback by default: put the TLS
# terminator in front (see README.md), never expose 8637 directly.
NNS_CHAT_PUBLISH=127.0.0.1:8637

NNS_CHAT_POSTGRES_PASSWORD=nns
NNS_CHAT_POLL_INTERVAL_MS=30000
NNS_CHAT_MAX_PAGE=500
NNS_CHAT_LOG_LEVEL=info
